;; Kanata設定: CapsLock → Emacs風キーバインド
;; CapsLockを押している間だけnavレイヤーが有効になる

(defcfg
  process-unmapped-keys yes
)

(defsrc
  caps a b d e f h n p spc
)

(defalias
  ;; CapsLock単押し=何もしない(XX)、長押し=navレイヤー有効
  cap (tap-hold 150 150 XX (layer-toggle nav))
)

(deflayer default
  @cap a b d e f h n p spc
)

;; CapsLock押しながらの各キー動作
(deflayer nav
  _    home left del end rght bspc down up kana
)
